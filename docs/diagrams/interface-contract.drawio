<mxfile host="app.diagrams.net" agent="Claude">
  <diagram id="interface-contract" name="Interface Contract">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;fontSize=18;fontStyle=1;align=center;" value="Interface Contract: HA Sensor Attributes" vertex="1">
          <mxGeometry height="30" width="600" x="400" y="15" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;fontSize=11;fontStyle=2;align=center;fontColor=#94a3b8;" value="All data flows through Home Assistant sensor attributes — read-only via REST API — all prices in EUR/kWh" vertex="1">
          <mxGeometry height="18" width="600" x="400" y="44" as="geometry" />
        </mxCell>

        <!-- ════════════════════════════════════════════ -->
        <!-- PRODUCER COLUMN                             -->
        <!-- ════════════════════════════════════════════ -->
        <mxCell id="prod-header" parent="1" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#1e40af;align=center;" value="PRODUCER (spot-price-predictor)" vertex="1">
          <mxGeometry height="22" width="300" x="30" y="70" as="geometry" />
        </mxCell>

        <!-- Price Forecast Producer -->
        <mxCell id="p-hourly" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;" value="&lt;b&gt;coordinator._async_update_data()&lt;/b&gt;&#xa;&#xa;1. Fetch 170h weather from Open-Meteo&#xa;2. Build features per hour&#xa;3. Predict spot_eur_mwh via Ridge model&#xa;4. Convert to consumer_eur_kwh:&#xa;   (spot/1000 + margin + transfer&#xa;    + energy_tax) x VAT&#xa;5. Pack into forecast[] array" vertex="1">
          <mxGeometry height="160" width="280" x="30" y="100" as="geometry" />
        </mxCell>

        <!-- D(k) Duration Producer -->
        <mxCell id="p-dk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;" value="&lt;b&gt;coordinator._compute_duration_forecast()&lt;/b&gt;&#xa;&#xa;1. Group forecast hours by local date&#xa;2. Build segment features (night/morn/mid/eve)&#xa;3. Run duration_model.predict_day()&#xa;4. PAVA monotonic correction&#xa;5. Extract marginal prices per segment&#xa;6. Apply tariff conversion per segment&#xa;7. Sort + cumulative mean = D(k)&#xa;8. Pack into daily_forecast[] array" vertex="1">
          <mxGeometry height="170" width="280" x="30" y="280" as="geometry" />
        </mxCell>

        <!-- ════════════════════════════════════════════ -->
        <!-- SENSOR ENTITIES (CENTER)                    -->
        <!-- ════════════════════════════════════════════ -->
        <mxCell id="sensor-header" parent="1" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#ef4444;align=center;" value="HA SENSOR ENTITIES" vertex="1">
          <mxGeometry height="22" width="300" x="380" y="70" as="geometry" />
        </mxCell>

        <!-- Price Forecast Sensor -->
        <mxCell id="s-price" parent="1" style="shape=document;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;size=0.08;" value="&lt;b&gt;sensor.spot_price_predictor_price_forecast&lt;/b&gt;&#xa;&#xa;state: current consumer price [EUR/kWh]&#xa;&#xa;attributes:&#xa;  forecast: [  &lt;i&gt;// 170 entries, hourly&lt;/i&gt;&#xa;    {&#xa;      timestamp: &quot;2026-04-13T00:00:00+00:00&quot;&#xa;      spot_eur_mwh: 45.67&#xa;      consumer_eur_kwh: 0.0852&#xa;      wind: 6.3&#xa;      solar: 120&#xa;      temp: 5.2&#xa;    }&#xa;  ]&#xa;  week_min_eur_kwh: 0.0321&#xa;  week_avg_eur_kwh: 0.0784&#xa;  week_max_eur_kwh: 0.1850&#xa;  forecast_hours: 170" vertex="1">
          <mxGeometry height="290" width="280" x="390" y="100" as="geometry" />
        </mxCell>

        <!-- Duration Forecast Sensor -->
        <mxCell id="s-dk" parent="1" style="shape=document;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;size=0.08;" value="&lt;b&gt;sensor.spot_price_predictor_duration_forecast&lt;/b&gt;&#xa;&#xa;state: D(4) current day [EUR/kWh]&#xa;&#xa;attributes:&#xa;  daily_forecast: [  &lt;i&gt;// 7 entries, daily&lt;/i&gt;&#xa;    {&#xa;      date: &quot;2026-04-13&quot;&#xa;      weekday: &quot;Mon&quot;&#xa;      dk_consumer_eur_kwh: [  &lt;i&gt;// 24 values&lt;/i&gt;&#xa;        0.0321, 0.0415, 0.0502, ..., 0.0784&#xa;      ]  &lt;i&gt;// D(k) in EUR/kWh, k=1..24&lt;/i&gt;&#xa;      dk_spot_eur_mwh: [  &lt;i&gt;// 24 values&lt;/i&gt;&#xa;        22.5, 30.1, 38.7, ..., 52.3&#xa;      ]  &lt;i&gt;// D(k) in EUR/MWh, k=1..24&lt;/i&gt;&#xa;    }&#xa;  ]&#xa;  forecast_days: 7" vertex="1">
          <mxGeometry height="310" width="280" x="390" y="410" as="geometry" />
        </mxCell>

        <!-- ════════════════════════════════════════════ -->
        <!-- CONSUMER COLUMN                             -->
        <!-- ════════════════════════════════════════════ -->
        <mxCell id="cons-header" parent="1" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#166534;align=center;" value="CONSUMER (thermal-energy-optimization)" vertex="1">
          <mxGeometry height="22" width="350" x="740" y="70" as="geometry" />
        </mxCell>

        <!-- Price consumers -->
        <mxCell id="c-prices" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" value="&lt;b&gt;fetch_hourly_prices_7day()&lt;/b&gt;&#xa;&#xa;Reads: forecast[] attribute&#xa;Groups by date (need 20+ hours)&#xa;Returns: list[7][24] in EUR/kWh&#xa;&#xa;&lt;b&gt;fetch_nday_prices()&lt;/b&gt;&#xa;consumer_eur_kwh (direct)&#xa;Returns: list[n] daily avg EUR/kWh&#xa;&#xa;&lt;b&gt;fetch_tomorrow_prices()&lt;/b&gt;&#xa;Returns: list[24] HourlyPriceData" vertex="1">
          <mxGeometry height="190" width="280" x="750" y="100" as="geometry" />
        </mxCell>

        <!-- D(k) consumer -->
        <mxCell id="c-dk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" value="&lt;b&gt;fetch_dk_forecast()&lt;/b&gt;&#xa;&#xa;Reads: daily_forecast[] attribute&#xa;Transposes: sensor [day][k] to [k][day]&#xa;Direct EUR/kWh (no conversion)&#xa;Returns: DkForecast (row-per-k)" vertex="1">
          <mxGeometry height="100" width="280" x="750" y="310" as="geometry" />
        </mxCell>

        <!-- DkForecast dataclass -->
        <mxCell id="c-dkclass" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;align=left;" value="&lt;b&gt;DkForecast dataclass&lt;/b&gt;  (row-per-k orientation)&#xa;&#xa;dk_eur_kwh[k-1][day]   24 x N_days  EUR/kWh&#xa;dk_spot[k-1][day]       24 x N_days  EUR/MWh&#xa;dates[], weekdays[], n_days&#xa;&#xa;d(k, day, unit)       = single D(k) lookup&#xa;trajectory(k, unit)  = D(k) across all days&#xa;day_curve(day, unit) = D(1)..D(24) for one day" vertex="1">
          <mxGeometry height="160" width="280" x="750" y="430" as="geometry" />
        </mxCell>

        <!-- Cost computation -->
        <mxCell id="c-cost" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;" value="&lt;b&gt;compute_load_dk_cost()&lt;/b&gt;&#xa;k = ceil(Q / P_nom)&#xa;cost = Q x D(k)&#xa;marginal = k*D(k) - (k-1)*D(k-1)&#xa;&#xa;&lt;b&gt;compute_pv_aware_dk()&lt;/b&gt;&#xa;net_price = grid x (1-pv_frac) + feed_in x pv_frac&#xa;Sort + cumulative mean = D_net(k)" vertex="1">
          <mxGeometry height="135" width="280" x="750" y="610" as="geometry" />
        </mxCell>

        <!-- Arrows producer to sensor -->
        <mxCell id="ps1" edge="1" parent="1" source="p-hourly" target="s-price" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#b85450;strokeWidth=2;" value="publishes" />
        <mxCell id="ps2" edge="1" parent="1" source="p-dk" target="s-dk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#b85450;strokeWidth=2;" value="publishes" />

        <!-- Arrows sensor to consumer -->
        <mxCell id="sc1" edge="1" parent="1" source="s-price" target="c-prices" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;" value="reads" />
        <mxCell id="sc2" edge="1" parent="1" source="s-dk" target="c-dk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;strokeWidth=2;" value="reads" />

        <!-- Consumer internal -->
        <mxCell id="cc1" edge="1" parent="1" source="c-dk" target="c-dkclass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" value="creates" />
        <mxCell id="cc2" edge="1" parent="1" source="c-dkclass" target="c-cost" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" value="uses" />
        <mxCell id="cc3" edge="1" parent="1" source="c-prices" target="c-cost" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;" value="hourly prices for PV-aware D(k)" />

        <!-- Unit conversion note -->
        <mxCell id="unit-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;align=left;size=12;" value="&lt;b&gt;Unit Conversions:&lt;/b&gt;&#xa;&#xa;consumer_eur_kwh = EUR/kWh (direct)&#xa;spot_eur_mwh / 1000 = EUR/kWh&#xa;&#xa;No tariff/VAT/tax computation.&#xa;All prices arrive pre-processed in EUR/kWh." vertex="1">
          <mxGeometry height="110" width="230" x="30" y="490" as="geometry" />
        </mxCell>

        <!-- D(k) definition note -->
        <mxCell id="dk-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;align=left;size=12;" value="&lt;b&gt;D(k) Definition:&lt;/b&gt;&#xa;&#xa;D(k) = avg price for cheapest k hours&#xa;     = CVaR at level alpha = k/24&#xa;&#xa;D(1) = cheapest single hour&#xa;D(24) = daily average price&#xa;D(k) is monotonically non-decreasing" vertex="1">
          <mxGeometry height="120" width="230" x="30" y="620" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
