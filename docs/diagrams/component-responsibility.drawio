        <!-- ═══ KEY PRINCIPLE ═══ -->
        <mxCell id="principle" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;size=14;" value="&lt;b&gt;Key Design Principle:&lt;/b&gt;&#xa;&#xa;spot-price-predictor produces forecast data and publishes&#xa;it to HA sensor attributes. It has zero knowledge of&#xa;thermal loads, heating schedules, or building physics.&#xa;&#xa;thermal-energy-optimization reads pre-computed prices&#xa;from HA sensors. It has zero knowledge of ML models,&#xa;feature engineering, or tariff calculations.&#xa;&#xa;The D(k) matrix is the primary interface for cost-optimal&#xa;load scheduling: D(k) = CVaR at alpha = k/24." vertex="1">
          <mxGeometry height="185" width="340" x="30" y="670" as="geometry" />
        </mxCell>

