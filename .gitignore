# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Environment
.env
.venv/
venv/
env/

# Output (generated, not tracked)
output/*.parquet
output/*.json
output/*.html
output/_*.txt
# Retrain staging area. `output/*.json` does not match subdirectories, so
# without this the artifacts staged for a manual HA copy sit untracked but
# committable — and a stale one committed by accident silently replaces the
# shipped model. See docs/BACKLOG.md.
output/ha_deploy/
studies/install_figures/

# DtACI validation price cache (large, regenerable)
studies/_dtaci_*_prices_cache.json

# Fingrid net-load study cache (large, regenerable from Fingrid API)
studies/_fingrid_cache/

# v2.5.3 solar sub-model cache (Fingrid + Open-Meteo, regenerable)
studies/.cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# pytest-cov artifacts
.coverage
.coverage.*
htmlcov/

# Private user data — never committed.
# See docs/household_profile_schema.md for the design boundary.
# Local-only directory for individual HA snapshots and derived profiles.
studies/_private/*
!studies/_private/README.md
# Any HA recorder DB anywhere in the tree.
*.db
*.db-shm
*.db-wal
*.db-journal
# Household profile JSONs anywhere in the tree.
**/household_profile.json
**/household_profile_*.json
# Raw CSV exports (HA energy dashboard or similar).
**/_raw/*.csv
